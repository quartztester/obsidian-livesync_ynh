#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set --key=password --value="$password"

#=================================================
# INSTALL COUCHDB
#=================================================
ynh_script_progression "Installing CouchDB..."

# One CouchDB per server: the deb and its config tree are shared with the
# couchdb catalog app.
if [ -e /opt/couchdb/etc/local.d/couch_ynh.ini ]; then
	ynh_die --message="The couchdb app already manages the system CouchDB; uninstall it first."
fi

seed_couchdb_debconf
ynh_apt_install_dependencies_from_extra_repository \
	--repo="$COUCHDB_REPO" \
	--key="$COUCHDB_KEY" \
	--package="couchdb"

#=================================================
# ADD CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

ynh_config_add --template="couch.ini" \
	--destination="/opt/couchdb/etc/local.d/$app.ini"

#=================================================
# START THE SERVICE
#=================================================
ynh_script_progression "Starting CouchDB..."

fix_couchdb_ownership

ynh_systemctl --service=couchdb --action=restart \
	--wait_until="Apache CouchDB has started" --log_path="$log_path" --timeout=120

#=================================================
# CREATE THE DEFAULT SYNC DATABASE
#=================================================
ynh_script_progression "Creating the default sync database..."

create_sync_db

#=================================================
# SYSTEM INTEGRATION
#=================================================
ynh_script_progression "Setting up NGINX, log rotation, fail2ban and log integration..."

ynh_config_add_nginx

ynh_config_add_logrotate

# Register the deb's real unit name (service status in the webadmin keys on it).
yunohost service add couchdb --description="Sync server for the Obsidian LiveSync plugin" \
	--log="/var/log/$app/couchdb.log" --needs_exposed_ports "$port"

ynh_config_add_fail2ban --logpath="/var/log/$app/couchdb.log" \
	--failregex="\[warning\].*Authentication failed for user .+ from <HOST>"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
