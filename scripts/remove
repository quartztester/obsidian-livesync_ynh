#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SERVICE INTEGRATION IN YUNOHOST
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

if ynh_hide_warnings yunohost service status couchdb >/dev/null; then
	yunohost service remove couchdb
fi

# The deb package itself goes away with $app-ynh-deps; drop our unit drop-in.
ynh_safe_rm "/etc/systemd/system/couchdb.service.d/$app.conf"
ynh_safe_rm "/opt/couchdb/etc/local.d/$app.ini"
systemctl daemon-reload

ynh_config_remove_fail2ban
ynh_config_remove_logrotate
ynh_config_remove_nginx

# Remove the sync databases we created unless another app still uses them.
ynh_script_progression "Removing $app's systemd service is not needed (shared couchdb unit kept)..."

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
